{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Angelman: Development server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/rdrf/rdrf/manage.py",
      "args": [
        "runserver",
        "0.0.0.0:8000",
        "--settings=angelman.settings",
        "--nostatic"
      ],
      "cwd": "${workspaceFolder}/angelman",
      "envFile": "${workspaceFolder}/rdrf/.env_local",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/rdrf:${workspaceFolder}/angelman",
        "DBSERVER": "db",
        "DBPORT": "5432",
        "DBUSER": "webapp",
        "DBNAME": "webapp",
        "DBPASS": "webapp",
        "CLINICAL_DBSERVER": "clinicaldb",
        "CLINICAL_DBPORT": "5432",
        "CLINICAL_DBUSER": "webapp",
        "CLINICAL_DBNAME": "webapp",
        "CLINICAL_DBPASS": "webapp",
        "PRODUCTION": "0",
        "DESIGN_MODE": "1",
        "DJANGO_FIXTURES": "DEV",
        "EMAIL_HOST": "smtp4dev",
        "EMAIL_PORT": "25",
        "EMAIL_USE_TLS": "false",
        "DEFAULT_FROM_EMAIL": "test@xxx.local",
        "FILE_STORAGE": "FS",
        "TRRF_SITE_DOMAIN": "localhost:8000",
        "TRRF_SITE_NAME": "TRRF Local DEV",
        "RECAPTCHA_SITE_KEY": "6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI",
        "RECAPTCHA_SECRET_KEY": "6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe",
        "AWS_XRAY_SDK_ENABLED": "0",
        "BREACHED_PASSWORD_DETECTION_ENABLED": "True",
        "BREACHED_PASSWORD_ENDPOINT": "https://api.pwnedpasswords.com"
      },
      "django": true,
      "justMyCode": true
    }
  ]
}
