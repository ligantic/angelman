{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Compose (debugpy)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "runserver",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/rdrf",
          "remoteRoot": "/app"
        }
      ],
      "django": true,
      "justMyCode": true,
      "preLaunchTask": "Django: Start debug Compose"
    }
  ]
}
