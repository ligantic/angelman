{
  "name": "GASR Devcontainer",
  "dockerComposeFile": "../rdrf/docker-compose.yml",
  "service": "devcontainer",
  "runServices": ["db", "clinicaldb", "smtp4dev", "devcontainer"],
  "workspaceFolder": "/workspaces/fast-au/gasr",
  "shutdownAction": "stopCompose",
  "containerEnv": {
    "DJANGO_SETTINGS_MODULE": "angelman.settings",
    "PYTHONPATH": "/workspaces/fast-au/gasr/rdrf:/workspaces/fast-au/gasr/angelman"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Angelman Django",
      "onAutoForward": "notify"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.debugpy", "mkhl.direnv"]
    }
  },
  "postCreateCommand": "python -c \"import django; print(django.get_version())\""
}
